# 程序只读环境变量。这个文件只是模板，不要在这里写入真实密钥。
#
# Mac：从钥匙串注入当前 shell（source .env.example）
export MINERU_API_TOKEN="$(/usr/bin/security find-generic-password -a "$USER" -s mineru.api.token -w)"
#
# 更新或轮换 Token（-w 放在最后会提示输入，Token 不会进入 shell 历史）：
#   security add-generic-password -U -a "$USER" -s mineru.api.token -w
#
# VPS：把真实值写入权限为 600 的环境文件，不要进 git。
#
# 学术来源（见 docs/SOURCES.md）。联系邮箱不是密钥，但不要写进仓库。
# export LITFACTORY_CONTACT_EMAIL="you@example.org"   # 礼貌通道；启用 unpaywall 时必需
# export CORE_API_KEY=...                  # 启用 core 时必需，https://core.ac.uk/services/api 免费注册
# export SEMANTIC_SCHOLAR_API_KEY=...      # 可选，无 key 时经常限频
# export OPENALEX_API_KEY=...              # 可选，匿名检索繁忙时会限流
# export NCBI_API_KEY=...                  # 可选，PubMed 每秒请求数从 3 提到 10
# export ZOTERO_API_KEY=...                # 仅 zotero 的 web 模式需要
#
# 大模型（见 config/llm.yaml）。存入钥匙串：security add-generic-password -U -a "$USER" -s <服务名> -w
# export ANTHROPIC_API_KEY="$(/usr/bin/security find-generic-password -a "$USER" -s anthropic.api.key -w)"
# export OPENAI_API_KEY="$(/usr/bin/security find-generic-password -a "$USER" -s openai.api.key -w)"
# export GEMINI_API_KEY="$(/usr/bin/security find-generic-password -a "$USER" -s gemini.api.key -w)"
# export COMPAT_API_KEY="$(/usr/bin/security find-generic-password -a "$USER" -s compat.api.key -w)"
#
# 飞书渠道（见 docs/CHANNELS.md）。用单独的飞书应用，不要和 agent-autoloop 共用。
# export FEISHU_APP_ID="$(/usr/bin/security find-generic-password -a "$USER" -s feishu.litfactory.app_id -w)"
# export FEISHU_APP_SECRET="$(/usr/bin/security find-generic-password -a "$USER" -s feishu.litfactory.app_secret -w)"
#
# Zotero 本地写入的 key 由 litfactory zotero authorize 写进 ~/.config/litfactory/zotero-local-key（权限 600）。
# 想放在别处时用环境变量覆盖：export ZOTERO_LOCAL_API_KEY=...
